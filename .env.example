# 复制为仓库根目录 .env 后填写（.env 已被 gitignore，勿提交）
#   cp .env.example .env
#
# 达人简介语言识别走 OpenAI 兼容 Chat Completions（默认 DeepSeek）。
# 文档：https://api-docs.deepseek.com/zh-cn/

LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL_ID=deepseek-v4-flash

# Content review is enabled by default and fail-closed. No platform writes or ASR.
# Shopping anchors use the verified TikTok Shop type-35/33 contract only.
# Project config.toml/.env > process environment > explicit external dotenv.
CONTENT_REVIEW_ENABLED=true
TIKHUB_API_KEY=
ARK_API_KEY=
ARK_MODEL=doubao-seed-2-1-pro-260628
# External dotenv is optional; ONLY TIKHUB_API_KEY/ARK_API_KEY/ARK_MODEL are read.
# CONTENT_REVIEW_EXTERNAL_ENV_PATH=/absolute/path/to/explicit/.env
# FFMPEG_PATH=/absolute/path/to/ffmpeg
# CONTENT_REVIEW_CACHE_DIR=exports/content_review_cache
# Limits can only be reduced; maximum five serial visual requests per run.
# CONTENT_REVIEW_MAX_VISUAL_VIDEOS=5
